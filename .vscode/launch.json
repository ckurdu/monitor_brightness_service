{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Brightness Toggle (Current File)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.conda/bin/python",
            "env": {
                "DISPLAY": ":0",
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Brightness Toggle Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/brightness_toggle.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.conda/bin/python",
            "env": {
                "DISPLAY": ":0",
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Brightness GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/brightness_gui.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.conda/bin/python",
            "env": {
                "DISPLAY": ":0",
                "PYTHONPATH": "${workspaceFolder}",
                "QT_QPA_PLATFORM": "xcb"
            }
        },
        {
            "name": "Python: Test Brightness (Manual Mode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/brightness_toggle.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/.conda/bin/python",
            "env": {
                "DISPLAY": ":0",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": []
        },
        {
            "name": "Python: Test Night Color",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/brightness_toggle.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/.conda/bin/python",
            "env": {
                "DISPLAY": ":0",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "Switch to Night Color Mode"
        },
        {
            "name": "Python: Attach to Service",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": true,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${workspaceFolder}"
                }
            ]
        }
    ]
}
